# Habilita reescritura para servir vistas desde /views
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Documentos de error
    ErrorDocument 404 /404.html
    ErrorDocument 403 /403.html

    # Evita listar directorios
    Options -Indexes

    #
    # Canoniza accesos directos a /views/*.php hacia la raíz
    #
    RewriteCond %{THE_REQUEST} \s/+views/[^\s]+\.php[\s?] [NC]
    RewriteRule ^views/([^/]+\.php)$ $1 [R=302,L]

    #
    # Sirve archivos y directorios reales
    #
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    #
    # Módulos en subcarpetas:
    # /compras.php -> /views/compras/index.php
    #
    RewriteCond %{DOCUMENT_ROOT}/views/$1/index.php -f
    RewriteRule ^([A-Za-z0-9_-]+)\.php$ views/$1/index.php [L]

    #
    # Páginas de módulo:
    # /compras_detalle.php -> /views/compras/detalle.php
    #
    RewriteCond %{DOCUMENT_ROOT}/views/$1/$2.php -f
    RewriteRule ^([A-Za-z0-9_-]+)_([A-Za-z0-9_-]+)\.php$ views/$1/$2.php [L]

    #
    # URLs por carpeta:
    # /compras/
    #
    RewriteCond %{DOCUMENT_ROOT}/views/$1/index.php -f
    RewriteRule ^([A-Za-z0-9_-]+)/?$ views/$1/index.php [L]

    RewriteCond %{DOCUMENT_ROOT}/views/$1/$2.php -f
    RewriteRule ^([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)\.php$ views/$1/$2.php [L]

    #
    # Compatibilidad:
    # /archivo.php -> /views/archivo.php
    #
    RewriteCond %{DOCUMENT_ROOT}/views/$1 -f
    RewriteRule ^([^/]+\.php)$ views/$1 [L]
</IfModule>

